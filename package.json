{
  "name": "real-feeling-mattress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test server/*.test.js",
    "format": "prettier --write \"src/**/*.{jsx,css}\" \"server/*.js\" vite.config.js",
    "test:ui": "node qa/flows.mjs",
    "test:responsive": "node qa/responsive.mjs",
    "test:a11y": "node qa/accessibility-complete.mjs",
    "test:preview": "node qa/cookieless-preview.mjs",
    "db:setup": "node scripts/setup-database.mjs",
    "cloud:check": "node scripts/cloud-check.mjs",
    "test:cloud": "node --test server/media.test.js server/order-pdf.test.js",
    "test:checkout-ui": "node qa/cloud-checkout.mjs",
    "deploy:check": "node scripts/deploy-check.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.6",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^3.0.0",
    "sharp": "^0.35.4",
    "vite": "latest",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@playwright/test": "^1.63.0",
    "@vercel/nft": "^1.11.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": "22.x"
  }
