# =============================================================================
# REAL FEELING MATTRESS — Environment Variables
# =============================================================================
# Copy this to .env for local development. For Vercel, set these in the
# Vercel Dashboard under Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: PostgreSQL connection string (Neon / Supabase / any PostgreSQL)
# Get this from Neon Dashboard → Connect → "Transaction" or "Direct" pooler.
# For migrations/setup use the DIRECT connection (port 5432).
# For Vercel runtime use the TRANSACTION POOLER connection (port 6543).
# URL-encode special characters in the password!
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@ep-xxx-xxx-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# REQUIRED ON VERCEL: Your exact canonical HTTPS origin, no trailing slash.
# Must match your deployed Vercel domain exactly.
# Examples:
#   https://your-project.vercel.app
#   https://realdfeelingmattress.com
# -----------------------------------------------------------------------------
SITE_URL=https://your-project.vercel.app

# -----------------------------------------------------------------------------
# ImgBB API key for cloud image uploads (products, hero banners, etc.)
# Get yours at https://api.imgbb.com/
# -----------------------------------------------------------------------------
IMGBB_API_KEY=your_imgbb_api_key_here

# -----------------------------------------------------------------------------
# Google Sign-In Client ID (for customer login)
# Get from Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Add your Vercel domain to "Authorized JavaScript origins"
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# CRON_SECRET: A random string (32+ chars) to protect the maintenance cron.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also set this in Vercel Dashboard as the cron secret for /api/maintenance.
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Checkout mode: "preview" (default, order is a request) or "cod" (cash on delivery)
# -----------------------------------------------------------------------------
CHECKOUT_MODE=preview

# -----------------------------------------------------------------------------
# DATABASE SETUP ONLY (temporary, remove after running npm run db:setup):
# -----------------------------------------------------------------------------
# OWNER_EMAIL=your-email@example.com
# OWNER_PASSWORD=YourStrongPassword123+

# -----------------------------------------------------------------------------
# OPTIONAL: Custom PostgreSQL CA certificate (PEM) if your provider requires it.
# Neon does NOT need this — it uses standard TLS certificates.
# -----------------------------------------------------------------------------
# PG_CA_CERT=

# -----------------------------------------------------------------------------
# FORBIDDEN ON VERCEL (do NOT set these):
# DB_AUTO_SETUP=1
# DB_SEED_DEMO=1
# -----------------------------------------------------------------------------
